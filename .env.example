# Sao chép thành .env rồi sửa. npm start, npm run dev và dịch vụ launchd đều tự đọc .env.

# Cổng HTTP; `tailscale serve --bg 3000` phải trỏ đúng cổng này
PORT=3000

# Thư mục backup hằng ngày (giữ 14 bản). Mặc định là data/backups, nằm cùng ổ với DB.
# Nên trỏ sang thư mục được đồng bộ ra ngoài, ví dụ iCloud Drive:
# BACKUP_DIR="/Users/<tên>/Library/Mobile Documents/com~apple~CloudDocs/kho-backups"

# Bật khi chỉ truy cập qua HTTPS (tailscale serve): cookie đăng nhập chỉ gửi qua HTTPS.
# Đừng bật nếu còn mở bằng http://<ip>:3000, vì sẽ không đăng nhập được.
# NODE_ENV=production

# Chỉ dùng cho lần chạy đầu với DB chưa có tài khoản nào
# BOOTSTRAP_USERNAMES=admin,nguoinha
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_ADMIN_USERNAME=admin
